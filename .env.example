# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Secrets (>= 32 bytes each; app refuses to start otherwise)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-bytes
LOGIN_CHALLENGE_HMAC_KEY=change-me-challenge-hmac-key-32-bytes!

# JWT claims
JWT_ISSUER=kubota-backend
JWT_AUDIENCE=kubota-clients

# Email confirmation
REGISTRATION_EMAIL_CONFIRMATION_ENABLED=false
LOGIN_EMAIL_CONFIRMATION_ENABLED=false

# RBAC (UUID of the user who gets the admin role at bootstrap)
RBAC_BOOTSTRAP_ADMIN_USER_ID=

# CSRF origin whitelist (comma-separated)
CSRF_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:4200,http://localhost:8080

# SMTP (required when email confirmation is enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# File size limits (bytes)
AVATAR_MAX_FILE_SIZE_BYTES=5242880
CONVERT_MAX_FILE_SIZE_BYTES=10485760

# OpenTelemetry (optional; OTLP/HTTP, port 4318). Leave empty to disable.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kubota-backend
